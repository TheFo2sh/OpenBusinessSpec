{
  "systems": ["PaymentService", "PaymentProvider"],
  "flows": [
    {
      "system": "PaymentService",
      "startedBy": "Payer",
      "trigger": { "name": "Checkout payment form", "kind": "frontend" },
      "command": "InitiatePayment",
      "events": ["PaymentCreated"]
    },
    {
      "system": "PaymentService",
      "policy": {
        "name": "Authorize new payments",
        "description": "A payment is authorized with the provider as soon as it exists.",
        "rules": [{ "when": "PaymentCreated", "then": "AuthorizePayment" }]
      },
      "command": "AuthorizePayment",
      "events": [
        { "name": "PaymentAuthorized", "system": "PaymentProvider" },
        { "name": "PaymentFailed", "system": "PaymentProvider" }
      ]
    },
    {
      "system": "PaymentService",
      "policy": {
        "name": "Capture authorized payments",
        "rules": [
          {
            "when": "PaymentAuthorized",
            "then": "CapturePayment",
            "condition": { "field": "payment.status", "operator": "eq", "value": "authorized" },
            "description": "The money is taken as soon as the provider authorizes the payment."
          }
        ]
      },
      "command": "CapturePayment",
      "events": [{ "name": "PaymentCaptured", "system": "PaymentProvider" }]
    },
    {
      "system": "PaymentService",
      "trigger": { "name": "Abandoned payments sweep", "kind": "time", "cron": "0 2 * * *" },
      "command": "CancelPayment",
      "events": ["PaymentCanceled"]
    },
    {
      "system": "PaymentService",
      "startedBy": "Payer",
      "trigger": { "name": "Refund request form", "kind": "frontend" },
      "command": "RefundPayment",
      "events": ["RefundCreated", { "name": "RefundSucceeded", "system": "PaymentProvider" }, { "name": "RefundFailed", "system": "PaymentProvider" }]
    }
  ]
}
